// Set Step Global
// Sets the default tangent type for NEW keys to Step (out) with a Flat in tangent.
// Maya has no step on the in side, so Flat is used there. Change "flat" below
// if you want something else. Does not touch existing keys.
{
    keyTangent -global -inTangentType flat -outTangentType step;
    inViewMessage -amg "Default tangents: <hl>Step</hl>" -pos midCenter -fade;
}
