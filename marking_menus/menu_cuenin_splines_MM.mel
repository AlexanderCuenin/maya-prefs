
    menuItem
        -label "Flip Curve" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nFlip Average\nGraph Editor: flips selected keys (value * -1) around the average value of the\nselected keys, so the curve mirrors over its own center.\nWorks per curve. Tangents flip with the values.\n\nSet USE_MIDPOINT = True to pivot on (min + max) / 2 instead of the mean.\nThat's a truer \"center\" if your keys are bunched up on one side.\n\"\"\"\nimport maya.cmds as cmds\n\nUSE_MIDPOINT = False\n\n\ndef flip_average():\n    curves = cmds.keyframe(q=True, selected=True, name=True) or []\n    if not curves:\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n\n    cmds.undoInfo(openChunk=True, chunkName=\"flipAverage\")\n    try:\n        for crv in curves:\n            sel_times = cmds.keyframe(crv, q=True, selected=True, timeChange=True) or []\n            sel_values = cmds.keyframe(crv, q=True, selected=True, valueChange=True) or []\n            if not sel_times:\n                continue\n\n            if USE_MIDPOINT:\n                anchor = (min(sel_values) + max(sel_values)) / 2.0\n            else:\n                anchor = sum(sel_values) / float(len(sel_values))\n\n            for t in sel_times:\n                cmds.scaleKey(\n                    crv,\n                    time=(t, t),\n                    timeScale=1,\n                    timePivot=0,\n                    valueScale=-1,\n                    valuePivot=anchor,\n                )\n    finally:\n        cmds.undoInfo(closeChunk=True)\n\n\nflip_average()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "S" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 1
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem1;

    menuItem
        -label "Flip Left" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nFlip Left\nGraph Editor: flips selected keys (value * -1) around the nearest key to the\nLEFT of the selection. If there is no key outside the selection on the left,\nit pivots on the leftmost selected key instead.\nWorks per curve. Tangents flip with the values.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef flip_left():\n    curves = cmds.keyframe(q=True, selected=True, name=True) or []\n    if not curves:\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n\n    cmds.undoInfo(openChunk=True, chunkName=\"flipLeft\")\n    try:\n        for crv in curves:\n            sel_times = cmds.keyframe(crv, q=True, selected=True, timeChange=True) or []\n            if not sel_times:\n                continue\n\n            first = min(sel_times)\n            all_times = cmds.keyframe(crv, q=True, timeChange=True) or []\n\n            # nearest key left of the selection, else the leftmost selected key\n            left = [t for t in all_times if t < first - 1e-6]\n            anchor_time = max(left) if left else first\n            anchor = cmds.keyframe(\n                crv, q=True, time=(anchor_time, anchor_time), valueChange=True\n            )[0]\n\n            for t in sel_times:\n                cmds.scaleKey(\n                    crv,\n                    time=(t, t),\n                    timeScale=1,\n                    timePivot=0,\n                    valueScale=-1,\n                    valuePivot=anchor,\n                )\n    finally:\n        cmds.undoInfo(closeChunk=True)\n\n\nflip_left()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "SW" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 1
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem2;

    menuItem
        -label "Flip Right" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nFlip Right\nGraph Editor: flips selected keys (value * -1) around the nearest key to the\nRIGHT of the selection. If there is no key outside the selection on the right,\nit pivots on the rightmost selected key instead.\nWorks per curve. Tangents flip with the values.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef flip_right():\n    curves = cmds.keyframe(q=True, selected=True, name=True) or []\n    if not curves:\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n\n    cmds.undoInfo(openChunk=True, chunkName=\"flipRight\")\n    try:\n        for crv in curves:\n            sel_times = cmds.keyframe(crv, q=True, selected=True, timeChange=True) or []\n            if not sel_times:\n                continue\n\n            last = max(sel_times)\n            all_times = cmds.keyframe(crv, q=True, timeChange=True) or []\n\n            # nearest key right of the selection, else the rightmost selected key\n            right = [t for t in all_times if t > last + 1e-6]\n            anchor_time = min(right) if right else last\n            anchor = cmds.keyframe(\n                crv, q=True, time=(anchor_time, anchor_time), valueChange=True\n            )[0]\n\n            for t in sel_times:\n                cmds.scaleKey(\n                    crv,\n                    time=(t, t),\n                    timeScale=1,\n                    timePivot=0,\n                    valueScale=-1,\n                    valuePivot=anchor,\n                )\n    finally:\n        cmds.undoInfo(closeChunk=True)\n\n\nflip_right()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "SE" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 1
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem3;

    menuItem
        -label "Spline" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nAuto Tangent\nGraph Editor: sets the in and out tangents of the selected keys to Auto.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef auto_tangent():\n    if not cmds.keyframe(q=True, selected=True, keyframeCount=True):\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n    cmds.keyTangent(edit=True, inTangentType=\"auto\", outTangentType=\"auto\")\n\n\nauto_tangent()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "NW" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 1
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem4;

    menuItem
        -label "Step" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nStep Tangent\nGraph Editor: sets the OUT tangent of the selected keys to Step.\nIn tangents are left alone, since Maya only steps on the out side.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef step_tangent():\n    if not cmds.keyframe(q=True, selected=True, keyframeCount=True):\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n    cmds.keyTangent(edit=True, outTangentType=\"step\")\n\n\nstep_tangent()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "N" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 1
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem5;

    menuItem
        -label "Flat" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nFlat Tangent\nGraph Editor: sets the in and out tangents of the selected keys to Flat.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef flat_tangent():\n    if not cmds.keyframe(q=True, selected=True, keyframeCount=True):\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n    cmds.keyTangent(edit=True, inTangentType=\"flat\", outTangentType=\"flat\")\n\n\nflat_tangent()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "NE" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 1
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem6;

    menuItem
        -label "Buffer Snap" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nBuffer Snap\nGraph Editor: snapshots the current shape of the selected curves into Maya's\nbuffer curve, so you can edit and compare against the original.\nAlso turns on \"Show Buffer Curves\" in the Graph Editor.\n\nWorks on selected keys if there are any, otherwise on selected objects.\n\nMODE = \"store\"  -> save a new buffer (default)\nMODE = \"swap\"   -> swap the curve with its buffer (flip back to the old version)\n\"\"\"\nimport maya.cmds as cmds\n\nMODE = \"store\"\n\n\ndef buffer_snap():\n    has_keys = cmds.keyframe(q=True, selected=True, keyframeCount=True)\n    if not has_keys and not cmds.ls(selection=True):\n        cmds.warning(\"Select some keys or objects first.\")\n        return\n\n    if MODE == \"swap\":\n        cmds.bufferCurve(animation=\"keysOrObjects\", swap=True)\n    else:\n        cmds.bufferCurve(animation=\"keysOrObjects\", overwrite=True)\n\n    # make the buffer visible (editor name can differ, so don't die on it)\n    try:\n        cmds.animCurveEditor(\"graphEditor1GraphEd\", edit=True, showBufferCurves=\"on\")\n    except RuntimeError:\n        pass\n\n\nbuffer_snap()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "E" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem7;

    menuItem
        -label "Linear" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nLinear Tangent\nGraph Editor: sets the in and out tangents of the selected keys to Linear.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef linear_tangent():\n    if not cmds.keyframe(q=True, selected=True, keyframeCount=True):\n        cmds.warning(\"Select some keys in the Graph Editor first.\")\n        return\n    cmds.keyTangent(edit=True, inTangentType=\"linear\", outTangentType=\"linear\")\n\n\nlinear_tangent()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -radialPosition "W" 
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem8;

    menuItem
        -label "Spline Global" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nSet Auto Global\nSets the default tangent type for NEW keys to Auto (in and out).\nDoes not touch existing keys.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef set_auto_global():\n    cmds.keyTangent(g=True, inTangentType=\"auto\", outTangentType=\"auto\")\n    cmds.inViewMessage(amg=\"Default tangents: <hl>Auto</hl>\", pos=\"midCenter\", fade=True)\n\n\nset_auto_global()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem9;

    menuItem
        -label "Step Global" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nSet Step Global\nSets the default tangent type for NEW keys to Step (out) with a Flat in tangent.\nMaya has no step on the in side, so Flat is used there. Change IN_TYPE if you\nwant something else. Does not touch existing keys.\n\"\"\"\nimport maya.cmds as cmds\n\nIN_TYPE = \"flat\"\n\n\ndef set_step_global():\n    cmds.keyTangent(g=True, inTangentType=IN_TYPE, outTangentType=\"step\")\n    cmds.inViewMessage(amg=\"Default tangents: <hl>Step</hl>\", pos=\"midCenter\", fade=True)\n\n\nset_step_global()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem10;

