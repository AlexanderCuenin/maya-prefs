    menuItem
        -label "Euler" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nSmart Euler Filter\nRuns Maya's Euler filter on rotation curves only.\n\nCurves come from the selected keys if there are any, otherwise from the\nselected objects. For every node it finds, it grabs ALL THREE rotate curves\n(X, Y, Z), because the filter needs the full set to work. Non-rotation curves\nare skipped. Filters the whole curve, not just the selected keys.\n\"\"\"\nimport maya.cmds as cmds\n\nROT_ATTRS = (\"rotateX\", \"rotateY\", \"rotateZ\", \"rx\", \"ry\", \"rz\")\n\n\ndef _scope_curves():\n    curves = cmds.keyframe(q=True, selected=True, name=True) or []\n    if curves:\n        return curves\n    sel = cmds.ls(selection=True)\n    return (cmds.keyframe(sel, q=True, name=True) or []) if sel else []\n\n\ndef smart_euler_filter():\n    curves = _scope_curves()\n    if not curves:\n        cmds.warning(\"Select keys or objects with animation first.\")\n        return\n\n    nodes = set()\n    for crv in set(curves):\n        plugs = cmds.listConnections(crv + \".output\", plugs=True, source=False, destination=True) or []\n        for plug in plugs:\n            node, attr = plug.split(\".\", 1)\n            if attr in ROT_ATTRS:\n                nodes.add(node)\n\n    if not nodes:\n        cmds.warning(\"No rotation curves found.\")\n        return\n\n    count = 0\n    cmds.undoInfo(openChunk=True, chunkName=\"smartEulerFilter\")\n    try:\n        for node in nodes:\n            rot_curves = []\n            for axis in \"XYZ\":\n                src = cmds.listConnections(node + \".rotate\" + axis, source=True, destination=False) or []\n                rot_curves += [c for c in src if cmds.nodeType(c).startswith(\"animCurve\")]\n            if rot_curves:\n                cmds.filterCurve(*rot_curves, filter=\"euler\")\n                count += 1\n    finally:\n        cmds.undoInfo(closeChunk=True)\n\n    print(\"Euler filtered rotation on %d node(s).\" % count)\n\n\nsmart_euler_filter()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem16;

    menuItem
        -label "separator" 
        -divider 1
        -dividerLabel "separator" 
        -subMenu 0
        -tearOff 0
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -italicized 0
        -boldFont 0
        -sourceType "mel" 
        -longDivider 1
        menuEditorMenuItem17;

    menuItem
        -label "Kill Static Curves" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nStatic Anim Curves\nDeletes animation curves that don't actually animate (every key has the same\nvalue). The attribute keeps its value, it just loses the curve.\n\nIf you have keys selected, only those curves are checked.\nIf not, every curve on the selected objects is checked.\nDriven key curves (set driven key) are skipped.\n\"\"\"\nimport maya.cmds as cmds\n\nTOL = 1e-5  # max value spread that still counts as static\n\n\ndef static_anim_curves():\n    sel_curves = cmds.keyframe(q=True, selected=True, name=True) or []\n    if sel_curves:\n        curves = sel_curves\n    else:\n        sel = cmds.ls(selection=True)\n        curves = (cmds.keyframe(sel, q=True, name=True) or []) if sel else []\n\n    if not curves:\n        cmds.warning(\"Select keys or objects with animation first.\")\n        return\n\n    deleted = 0\n    cmds.undoInfo(openChunk=True, chunkName=\"staticAnimCurves\")\n    try:\n        for crv in set(curves):\n            if not cmds.objExists(crv):\n                continue\n            # skip set driven keys\n            if cmds.listConnections(crv + \".input\", source=True, destination=False):\n                continue\n            vals = cmds.keyframe(crv, q=True, valueChange=True) or []\n            if vals and (max(vals) - min(vals)) < TOL:\n                cmds.delete(crv)\n                deleted += 1\n    finally:\n        cmds.undoInfo(closeChunk=True)\n\n    print(\"Deleted %d static curve(s).\" % deleted)\n\n\nstatic_anim_curves()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem18;

    menuItem
        -label "Kill Redundant Keys" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nRedundant Keys\nDeletes keys that do nothing: a key is redundant when its value matches both\nneighbors and the tangents around it are flat, so removing it can't change the\ncurve shape. First and last keys on a curve are never deleted.\n\nIf you have keys selected, only those keys are checked.\nIf not, every key on the selected objects is checked.\n\"\"\"\nimport maya.cmds as cmds\n\nVALUE_TOL = 1e-4   # how close values must be to count as equal\nANGLE_TOL = 1e-3   # how close to zero a tangent angle must be to count as flat\n\n\ndef redundant_keys():\n    sel_curves = cmds.keyframe(q=True, selected=True, name=True) or []\n    use_selection = bool(sel_curves)\n    if use_selection:\n        curves = sel_curves\n    else:\n        sel = cmds.ls(selection=True)\n        curves = (cmds.keyframe(sel, q=True, name=True) or []) if sel else []\n\n    if not curves:\n        cmds.warning(\"Select keys or objects with animation first.\")\n        return\n\n    removed = 0\n    cmds.undoInfo(openChunk=True, chunkName=\"redundantKeys\")\n    try:\n        for crv in set(curves):\n            times = cmds.keyframe(crv, q=True, timeChange=True) or []\n            if len(times) < 3:\n                continue\n            vals = cmds.keyframe(crv, q=True, valueChange=True)\n            in_ang = cmds.keyTangent(crv, q=True, inAngle=True)\n            out_ang = cmds.keyTangent(crv, q=True, outAngle=True)\n\n            selected = set()\n            if use_selection:\n                selected = set(round(t, 4) for t in\n                               (cmds.keyframe(crv, q=True, selected=True, timeChange=True) or []))\n\n            to_delete = []\n            for i in range(1, len(times) - 1):\n                if use_selection and round(times[i], 4) not in selected:\n                    continue\n                if abs(vals[i] - vals[i - 1]) > VALUE_TOL or abs(vals[i] - vals[i + 1]) > VALUE_TOL:\n                    continue\n                flat = (\n                    abs(out_ang[i - 1]) <= ANGLE_TOL\n                    and abs(in_ang[i]) <= ANGLE_TOL\n                    and abs(out_ang[i]) <= ANGLE_TOL\n                    and abs(in_ang[i + 1]) <= ANGLE_TOL\n                )\n                if flat:\n                    to_delete.append(times[i])\n\n            for t in to_delete:\n                cmds.cutKey(crv, time=(t, t), clear=True)\n            removed += len(to_delete)\n    finally:\n        cmds.undoInfo(closeChunk=True)\n\n    print(\"Deleted %d redundant key(s).\" % removed)\n\n\nredundant_keys()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem19;

setParent -m ..;

