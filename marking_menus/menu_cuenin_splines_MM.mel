    menuItem
        -label "Spline Global" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nSet Auto Global\nSets the default tangent type for NEW keys to Auto (in and out).\nDoes not touch existing keys.\n\"\"\"\nimport maya.cmds as cmds\n\n\ndef set_auto_global():\n    cmds.keyTangent(g=True, inTangentType=\"auto\", outTangentType=\"auto\")\n    cmds.inViewMessage(amg=\"Default tangents: <hl>Auto</hl>\", pos=\"midCenter\", fade=True)\n\n\nset_auto_global()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
        -postMenuCommandOnce 0
        -enableCommandRepeat 1
        -echoCommand 0
        -italicized 0
        -boldFont 0
        -sourceType "python" 
        -longDivider 1
        menuEditorMenuItem9;

    menuItem
        -label "Step Global" 
        -divider 0
        -subMenu 0
        -tearOff 0
        -command "\"\"\"\nSet Step Global\nSets the default tangent type for NEW keys to Step (out) with a Flat in tangent.\nMaya has no step on the in side, so Flat is used there. Change IN_TYPE if you\nwant something else. Does not touch existing keys.\n\"\"\"\nimport maya.cmds as cmds\n\nIN_TYPE = \"flat\"\n\n\ndef set_step_global():\n    cmds.keyTangent(g=True, inTangentType=IN_TYPE, outTangentType=\"step\")\n    cmds.inViewMessage(amg=\"Default tangents: <hl>Step</hl>\", pos=\"midCenter\", fade=True)\n\n\nset_step_global()" 
        -optionBox 0
        -header 0
        -enable 1
        -visible 1
        -data 0
        -allowOptionBoxes 1
